# ===== Google OAuth 設定 =====
# 你從 Google Cloud Console 下載的 OAuth 用戶端 JSON 檔路徑
GOOGLE_CLIENT_SECRETS=credentials.json

# 執行 authorize.py 後產生的授權 token 檔路徑（請勿外流）
GOOGLE_TOKEN_FILE=token.json

# 要把照片上傳到哪個 Google Drive 資料夾的 ID
# 從資料夾網址取得，例如 https://drive.google.com/drive/folders/XXXXXXXX 的 XXXXXXXX
DRIVE_FOLDER_ID=

# ===== 伺服器設定 =====
# 對外公開的網址（給 QR code 用）。本機測試可留 http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000

# 單一檔案大小上限（MB）
MAX_FILE_SIZE_MB=50

# 伺服器埠號
PORT=8000
